{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-actions-cron-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      // Daily at 10:40 UTC == 16:10 (4:10 PM) IST
      "40 10 * * *"
    ]
  }
}
