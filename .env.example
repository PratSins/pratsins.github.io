# Copy this file to `.env` and fill in the value. `.env` is gitignored.
#
# A GitHub personal access token, used ONLY at build time to read your
# contribution calendar. It never reaches the browser — `npm run contributions`
# runs on your machine and writes the result to src/data/contributions.json.
#
# Create one at:  https://github.com/settings/tokens
#   -> Tokens (classic) -> Generate new token
#   -> Scope needed: read:user     (that alone is enough)
#
# Querying as `viewer` (which is what the script does) means the calendar
# includes your PRIVATE contributions, not just public ones.
GH_CONTRIB_TOKEN=ghp_yourtokenhere
